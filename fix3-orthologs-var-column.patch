+def test_map_orthologs_prefers_var_column(cfg, tmp_path):
+    import pandas as pd
+    from sctarget.session import AnalysisSession
+    from sctarget.tools import analysis as A, knowledge as K
+
+    s = AnalysisSession.create(cfg, tmp_path / "orth")
