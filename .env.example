# Copy to .env (or export in your shell). Never commit .env.

# Required for live agent runs. Not needed for --model scripted or for tests.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent roles. Any current Claude model ID works.
SCTARGET_MODEL=claude-sonnet-4-5

# 1 = never call external knowledge APIs; use bundled fixtures only.
# Useful on air-gapped nodes and in CI.
SCTARGET_OFFLINE=0

# Where to cache knowledge-API responses (default: ./cache)
SCTARGET_CACHE_DIR=./cache
